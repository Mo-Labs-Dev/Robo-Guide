# Copy to config/.env and fill in. config/.env is git-ignored and loaded by scripts/start_gui.sh.
# Never commit real values.

# Tapo "Camera Account" (Tapo app > camera > Advanced Settings > Camera Account).
# This is NOT your TP-Link cloud login.
RG_CAMERA_USER=
RG_CAMERA_PASSWORD=
# Optional per-camera overrides (camera numbers as in Settings):
# RG_CAM3_USER=
# RG_CAM3_PASSWORD=

# Jira Cloud: account e-mail + API token. Jira Data Center: leave RG_JIRA_USER empty and put a
# personal access token in RG_JIRA_TOKEN.
RG_JIRA_USER=
RG_JIRA_TOKEN=

# Xray Cloud API key (Jira > Apps > Xray > API Keys). Not needed for Xray Server/DC.
RG_XRAY_CLIENT_ID=
RG_XRAY_CLIENT_SECRET=
