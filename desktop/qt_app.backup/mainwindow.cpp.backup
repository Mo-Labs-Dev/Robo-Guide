#include "mainwindow.h"
#include <QVBoxLayout>
#include <QGridLayout>
#include <QWidget>
#include <QGroupBox>
#include <QDateTime>
#include <QStringList>
#include <cmath>
MainWindow::MainWindow(QWidget *parent)
   : QMainWindow(parent)
{
   setupUI();
   setupROS();
}
MainWindow::~MainWindow()
{
   if (rosTimer_)
       rosTimer_->stop();
   jointSubscriber_.reset();
   statusSubscriber_.reset();
   rosNode_.reset();
}
void MainWindow::setupUI()
{
   setWindowTitle("RoboTest Studio | Robot Monitoring");
   resize(1050, 700);
   auto *central = new QWidget(this);
   auto *layout = new QVBoxLayout(central);
   auto *title = new QLabel("RoboTest Studio");
   title->setStyleSheet(
       "font-size: 26px; font-weight: bold;");
   layout->addWidget(title);
   auto *statusGroup = new QGroupBox("Robot Connection");
   auto *statusLayout = new QVBoxLayout(statusGroup);
   rosStatusLabel_ =
       new QLabel("ROS 2: Initializing...");
   robotStatusLabel_ =
       new QLabel("Robot: Waiting for status...");
   statusLayout->addWidget(rosStatusLabel_);
   statusLayout->addWidget(robotStatusLabel_);
   layout->addWidget(statusGroup);
   auto *jointGroup = new QGroupBox("Live Joint Positions");
   auto *jointLayout = new QGridLayout(jointGroup);
   const QStringList names = {
       "Base", "Shoulder", "Elbow", "Hand"
   };
   for (int i = 0; i < 4; ++i)
   {
       auto *nameLabel = new QLabel(names[i]);
       jointLabels_[i] = new QLabel("Waiting...");
       jointLabels_[i]->setStyleSheet(
           "font-size: 17px; font-weight: bold;");
       jointLayout->addWidget(nameLabel, i, 0);
       jointLayout->addWidget(jointLabels_[i], i, 1);
   }
   layout->addWidget(jointGroup);
   auto *logGroup = new QGroupBox("Activity Log");
   auto *logLayout = new QVBoxLayout(logGroup);
   logView_ = new QTextEdit();
   logView_->setReadOnly(true);
   logLayout->addWidget(logView_);
   layout->addWidget(logGroup);
   setCentralWidget(central);
}
void MainWindow::setupROS()
{
   rosNode_ = std::make_shared<rclcpp::Node>(
       "robotest_studio_gui");
   statusSubscriber_ =
       rosNode_->create_subscription<std_msgs::msg::String>(
           "/robotest/robot/status",
           10,
           [this](const std_msgs::msg::String::SharedPtr msg)
           {
               const QString status =
                   QString::fromStdString(msg->data);
               robotStatusLabel_->setText(status);
               logView_->append(
                   QDateTime::currentDateTime()
                       .toString("HH:mm:ss")
                   + " | " + status);
           });
   jointSubscriber_ =
       rosNode_->create_subscription<sensor_msgs::msg::JointState>(
           "/robotest/robot/joint_states",
           10,
           [this](
               const sensor_msgs::msg::JointState::SharedPtr msg)
           {
               if (msg->position.size() < 4)
                   return;
               constexpr double RAD_TO_DEG =
                   180.0 / 3.14159265358979323846;
               for (int i = 0; i < 4; ++i)
               {
                   const double radians = msg->position[i];
                   const double degrees = radians * RAD_TO_DEG;
                   jointLabels_[i]->setText(
                       QString("%1 rad  |  %2°")
                           .arg(radians, 0, 'f', 3)
                           .arg(degrees, 0, 'f', 1));
               }
           });
   rosTimer_ = new QTimer(this);
   connect(rosTimer_, &QTimer::timeout,
           this, [this]()
           {
               if (rclcpp::ok())
                   rclcpp::spin_some(rosNode_);
           });
   rosTimer_->start(50);
   rosStatusLabel_->setText(
       "ROS 2 Jazzy: Middleware initialized");
}
