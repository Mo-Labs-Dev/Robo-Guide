#include <chrono>
#include <cmath>
#include <functional>
#include <memory>
#include <string>
#include <vector>
#include <curl/curl.h>
#include <nlohmann/json.hpp>
#include "rclcpp/rclcpp.hpp"
#include "std_msgs/msg/string.hpp"
#include "sensor_msgs/msg/joint_state.hpp"
using namespace std::chrono_literals;
using json = nlohmann::json;
class WaveshareDriverNode : public rclcpp::Node
{
public:
   WaveshareDriverNode()
       : Node("waveshare_driver_node")
   {
       simulation_ = declare_parameter<bool>(
           "simulation", true);
       robot_ip_ = declare_parameter<std::string>(
           "robot_ip", "192.168.178.31");
       status_pub_ =
           create_publisher<std_msgs::msg::String>(
               "/robotest/robot/status", 10);
       joint_pub_ =
           create_publisher<sensor_msgs::msg::JointState>(
               "/robotest/robot/joint_states", 10);
       if (curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK)
       {
           throw std::runtime_error(
               "Failed to initialize libcurl");
       }
       timer_ = create_wall_timer(
           1000ms,
           std::bind(
&WaveshareDriverNode::update,
               this));
       RCLCPP_INFO(
           get_logger(),
           "RoArm-M2-S driver started | Mode: %s",
           simulation_ ? "SIMULATION" : "HARDWARE READ-ONLY");
   }
   ~WaveshareDriverNode() override
   {
       timer_.reset();
       curl_global_cleanup();
   }
private:
   bool simulation_;
   std::string robot_ip_;
   rclcpp::Publisher<std_msgs::msg::String>::SharedPtr
       status_pub_;
   rclcpp::Publisher<sensor_msgs::msg::JointState>::SharedPtr
       joint_pub_;
   rclcpp::TimerBase::SharedPtr timer_;
   static size_t writeCallback(
       char *data,
       size_t size,
       size_t count,
       void *user_data)
   {
       const size_t bytes = size * count;
       auto *response =
           static_cast<std::string *>(user_data);
       response->append(data, bytes);
       return bytes;
   }
   void publishStatus(const std::string &status)
   {
       std_msgs::msg::String msg;
       msg.data = status;
       status_pub_->publish(msg);
   }
   void publishJoints(
       double b,
       double s,
       double e,
       double t)
   {
       sensor_msgs::msg::JointState msg;
       msg.header.stamp = now();
       msg.name = {
           "base",
           "shoulder",
           "elbow",
           "hand"
       };
       msg.position = {b, s, e, t};
       joint_pub_->publish(msg);
   }
   bool readHardware()
   {
       // Fixed, read-only feedback request.
       // No movement commands are implemented.
       const std::string url =
           "http://" + robot_ip_ +
           "/js?json=%7B%22T%22%3A105%7D";
       CURL *curl = curl_easy_init();
       if (!curl)
           return false;
       std::string response;
       curl_easy_setopt(
           curl, CURLOPT_URL, url.c_str());
       curl_easy_setopt(
           curl, CURLOPT_WRITEFUNCTION,
           writeCallback);
       curl_easy_setopt(
           curl, CURLOPT_WRITEDATA, &response);
       curl_easy_setopt(
           curl, CURLOPT_CONNECTTIMEOUT_MS, 1000L);
       curl_easy_setopt(
           curl, CURLOPT_TIMEOUT_MS, 2000L);
       curl_easy_setopt(
           curl, CURLOPT_FOLLOWLOCATION, 0L);
       curl_easy_setopt(
           curl, CURLOPT_NOSIGNAL, 1L);
       curl_easy_setopt(
           curl, CURLOPT_NOPROXY, "*");
       const CURLcode result =
           curl_easy_perform(curl);
       long http_code = 0;
       curl_easy_getinfo(
           curl,
           CURLINFO_RESPONSE_CODE,
&http_code);
       curl_easy_cleanup(curl);
       if (result != CURLE_OK || http_code != 200)
           return false;
       try
       {
           const json data = json::parse(response);
           if (!data.contains("T") ||
               !data["T"].is_number_integer() ||
               data["T"].get<int>() != 1051)
           {
               return false;
           }
           const double b = data.at("b").get<double>();
           const double s = data.at("s").get<double>();
           const double e = data.at("e").get<double>();
           const double t = data.at("t").get<double>();
           if (!std::isfinite(b) ||
               !std::isfinite(s) ||
               !std::isfinite(e) ||
               !std::isfinite(t))
           {
               return false;
           }
           publishJoints(b, s, e, t);
           return true;
       }
       catch (const json::exception &)
       {
           return false;
       }
   }
   void update()
   {
       if (simulation_)
       {
           publishStatus(
               "SIMULATION | RoArm-M2-S | READY");
           publishJoints(0.0, 0.0, 1.57, 1.57);
           return;
       }
       if (readHardware())
       {
           publishStatus(
               "HARDWARE | RoArm-M2-S | CONNECTED");
           RCLCPP_INFO(
               get_logger(),
               "Real robot feedback received");
       }
       else
       {
           publishStatus(
               "HARDWARE | RoArm-M2-S | DISCONNECTED");
           RCLCPP_WARN(
               get_logger(),
               "Robot feedback unavailable");
       }
   }
};
int main(int argc, char **argv)
{
   rclcpp::init(argc, argv);
   auto node =
       std::make_shared<WaveshareDriverNode>();
   rclcpp::spin(node);
   rclcpp::shutdown();
   return 0;
}
